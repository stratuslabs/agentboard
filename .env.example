# Required: Postgres connection string. Any Postgres works — a local container,
# Neon, Supabase, RDS, or your own server. DATABASE_URL is accepted as a
# fallback, which is the name Neon's Vercel integration sets.
# Local (docker compose): postgresql://agentboard:agentboard@localhost:5432/agentboard
POSTGRES_URL=

# Optional: max pooled connections per process (default 5). Lower it if you run
# many serverless instances against a server with a small connection limit.
# POSTGRES_POOL_MAX=5

# Optional: a direct (unpooled) connection string, used only to listen for board
# changes. Live updates are delivered over LISTEN/NOTIFY, which needs a
# connection of its own — a pooler in transaction mode hands each statement to a
# different backend and drops the subscription. Only needed when POSTGRES_URL
# points at a pooled endpoint, such as Neon's `-pooler.` host. When unset, the
# event stream polls instead and everything still works, just less immediately.
# DIRECT_POSTGRES_URL=

# Optional: how long an event stream stays open before asking the client to
# reconnect, in seconds (default 240). The client reconnects and catches up
# without showing anything, so this is a resource dial, not a UX one. Serverless
# platforms cap streaming responses — the default sits inside Vercel's limit.
# A long-running server has no such limit and can raise it freely.
# SSE_MAX_SECONDS=240

# Optional: how often the event stream checks for changes when it has no
# LISTEN connection, in milliseconds (default 2000).
# SSE_POLL_MS=2000

# Optional: Password protection for the web UI
# If not set, the app runs without authentication (open access)
APP_PASSWORD=

# Optional: Default timezone (used for server-side date calculations)
# TZ=America/New_York
