# Required: Postgres connection string. Any Postgres works — a local container,
# Neon, Supabase, RDS, or your own server.
# Local (docker compose): postgresql://agentboard:agentboard@localhost:5432/agentboard
POSTGRES_URL=

# Optional: max pooled connections per process (default 5). Lower it if you run
# many serverless instances against a server with a small connection limit.
# POSTGRES_POOL_MAX=5

# Optional: Password protection for the web UI
# If not set, the app runs without authentication (open access)
APP_PASSWORD=

# Optional: Default timezone (used for server-side date calculations)
# TZ=America/New_York
