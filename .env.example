# Required: pooled Postgres connection string.
# NOTE: the app uses @vercel/postgres, which speaks Neon's SQL-over-HTTP
# protocol — it needs a Neon-backed database, not a plain Postgres server.
POSTGRES_URL=

# Optional: direct (non-pooled) connection. Nothing in the app reads this today
# — it is only used if you switch to @vercel/postgres's createClient().
POSTGRES_URL_NON_POOLING=

# Optional: Password protection for the web UI
# If not set, the app runs without authentication (open access)
APP_PASSWORD=

# Optional: Default timezone (used for server-side date calculations)
# TZ=America/New_York
